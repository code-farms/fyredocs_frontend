# Copy to .env (gitignored) and adjust locally.

# When empty, the frontend uses relative URLs (same-origin via the Caddy edge).
# Set this only for local development when frontend runs on a separate port.
# VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=

# Vite dev-server proxy target. Only used by `vite dev` / `vite preview`;
# ignored by production builds (vite build). Leave commented to default to
# http://localhost — the Caddy edge, which fronts the api-gateway, MinIO, and
# Grafana. Point it at http://localhost:8080 to bypass Caddy and hit the
# gateway directly. Override per-developer in .env.local (gitignored) or with
# a shell export: `API_PROXY_TARGET=... npm run dev`.
# API_PROXY_TARGET=http://localhost

# Hide the signup UI (links + /signup redirects to /signin). Build-time: needs a
# rebuild. This only hides the UI; set auth-service's SIGNUP_ENABLED=false too,
# or the API still accepts signups.
# VITE_SIGNUP_ENABLED=false

# Hide the notification bell (stops its SSE stream and 30s poll). Set to false
# whenever notification-service is not running (it is off by default behind the
# backend's `notifications` compose profile), or every page logs 502s.
# VITE_NOTIFICATIONS_ENABLED=false
